<Window x:Class="one_armed_bandit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:one_armed_bandit"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Background.png"/>
        </Grid.Background>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center" Width="768">

            <TextBlock Text="JACKPOT"
                       FontSize="56"
                       FontWeight="Bold"
                       Foreground="Gold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- A három kerék -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,17.5">

                <!-- 1. kerék -->
                <Border Width="140"
                        Height="180"
                        Background="White"
                        BorderBrush="Gold"
                        BorderThickness="6"
                        CornerRadius="18"
                        Margin="2">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Reel1Top"
                                   Text="?"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="Black"/>
                        <TextBlock x:Name="Reel1Middle"
                                   Text="?"
                                   FontSize="70"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="DarkRed"/>
                        <TextBlock x:Name="Reel1Bottom"
                                   Text="?"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="Black"/>
                    </StackPanel>
                </Border>

                <!-- 2. kerék -->
                <Border Width="140"
                        Height="180"
                        Background="White"
                        BorderBrush="Gold"
                        BorderThickness="6"
                        CornerRadius="18"
                        Margin="2">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Reel2Top"
                                   Text="?"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="Black"/>
                        <TextBlock x:Name="Reel2Middle"
                                   Text="?"
                                   FontSize="70"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="DarkRed"/>
                        <TextBlock x:Name="Reel2Bottom"
                                   Text="?"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="Black"/>
                    </StackPanel>
                </Border>

                <!-- 3. kerék -->
                <Border Width="140"
                        Height="180"
                        Background="White"
                        BorderBrush="Gold"
                        BorderThickness="6"
                        CornerRadius="18"
                        Margin="2">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Reel3Top"
                                   Text="?"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="Black"/>
                        <TextBlock x:Name="Reel3Middle"
                                   Text="?"
                                   FontSize="70"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="DarkRed"/>
                        <TextBlock x:Name="Reel3Bottom"
                                   Text="?"
                                   FontSize="50"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Foreground="Black"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- Alsó rész: egyenleg, gomb, eredmény -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <TextBlock x:Name="BalanceText"
                           Text="Egyenleg: 100 kredit"
                           Width="260"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           TextAlignment="Center"/>

                <Border
                    BorderBrush="#FF067600"
                        BorderThickness="4"
                        CornerRadius="10"
                                            Margin="10,0, 10, 10">
                   
                <Button x:Name="SpinButton"
                        Content="PÖRGETÉS"
                        Width="180"
                        Height="50"
                        FontSize="28"
                        FontWeight="Bold"
                        Background="LimeGreen"
                        Foreground="White"
                        Click="SpinButton_Click"/>
                </Border>
                <TextBlock x:Name="ResultText"
                           Text="Eredmény: -"
                           Width="260"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           TextAlignment="Center"/>

            </StackPanel>

        </StackPanel>

    </Grid>
</Window>
